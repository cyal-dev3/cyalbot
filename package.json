{
  "name": "cyalbot",
  "version": "3.1.0",
  "description": "Bot de WhatsApp en TypeScript (Baileys) con RPG, moderación de grupos, descargas y chat con Claude",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "qr": "node dist/index.js --method=qr",
    "code": "node dist/index.js --method=code",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "telegram:session": "tsx src/generate-session.ts"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "typescript",
    "claude",
    "anthropic",
    "rpg"
  ],
  "author": "Cyal",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@distube/ytdl-core": "^4.16.12",
    "@hapi/boom": "^10.0.1",
    "baileys": "^6.7.16",
    "chalk": "^5.3.0",
    "dotenv": "^17.2.3",
    "input": "^1.0.1",
    "lowdb": "^7.0.1",
    "node-cache": "^5.1.2",
    "node-webpmux": "^3.2.1",
    "pino": "^9.5.0",
    "play-dl": "^1.9.7",
    "qrcode-terminal": "^0.12.0",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
