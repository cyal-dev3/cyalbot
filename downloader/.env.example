# Configuracion del servicio cyalbot-downloader.
# Copia a .env (o pasa las variables al contenedor). Todo lo no definido usa el valor por defecto.

# ---------- Red ----------
# Puerto y host de escucha
PORT=3002
HOST=0.0.0.0
# Base publica que se devuelve en data.url. Debe ser alcanzable desde el bot.
# En docker-compose: http://downloader:3002. Local: http://localhost:3002
PUBLIC_URL=http://localhost:3002
# Si se define, todas las rutas salvo /health y /files exigen la cabecera x-api-key con este valor.
DOWNLOADER_API_KEY=

# ---------- Herramientas ----------
# Rutas a los binarios. Por defecto se buscan en PATH.
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Opcional: binario gallery-dl para posts con solo imagenes (Instagram, Pinterest, Threads).
GALLERYDL_PATH=
# Opcional: archivo de cookies en formato Netscape para sitios que piden login (Instagram, Facebook, YouTube con edad).
YTDLP_COOKIES=
# Opcional: --extractor-args para yt-dlp. Vacio = no se pasa.
YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,web

# ---------- Limites ----------
# Tamano maximo por archivo (MB). Pasarlo responde TOO_LARGE (413).
MAX_FILE_MB=60
# Tiempo maximo por peticion de descarga (ms). Al expirar se mata yt-dlp y se responde TIMEOUT (504).
DOWNLOAD_TIMEOUT_MS=120000
# Descargas simultaneas y tamano de la cola de espera. Cola llena = RATE_LIMITED (429).
MAX_CONCURRENT=2
QUEUE_MAX=20

# ---------- Archivos ----------
# Carpeta donde se guardan las descargas. Default: <tmpdir>/cyalbot-downloader
DOWNLOAD_DIR=
# Minutos que vive un archivo descargado antes de borrarse.
FILE_TTL_MIN=30
# Minutos que se reutiliza una descarga para la misma URL+quality+audioOnly.
CACHE_TTL_MIN=30

# ---------- Logs ----------
# debug | info | warn | error
LOG_LEVEL=info
