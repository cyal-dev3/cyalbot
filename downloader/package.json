{
  "name": "cyalbot-downloader",
  "version": "1.0.0",
  "description": "Servicio HTTP de descargas (yt-dlp + ffmpeg) para cyalbot. Solo modulos nativos de Node.",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
