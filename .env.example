# Copia este archivo a .env y rellena lo que uses.
# Todo lo que no se define toma el valor por defecto indicado.

# ---------- Bot ----------
# Nombre que muestra el bot en menús y stickers
BOT_NAME=CYALTRONIC
# Dueños del bot: números con código de país (o LID), separados por coma.
# Sin esto, los comandos de owner no están disponibles para nadie.
BOT_OWNERS=5210000000000
# Caracteres aceptados como prefijo de comando
BOT_PREFIX=!/.
# Carpeta de credenciales de WhatsApp y archivo de base de datos (SQLite). Si apunta a un .json
# antiguo, se importa una vez a <nombre>.sqlite y el JSON se renombra a .migrated
AUTH_FOLDER=CyaltronicSession
DATABASE_PATH=database.sqlite
# Nombre del proceso en pm2 (lo usan /restart y /logs)
PM2_NAME=CYALTRONIC
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# ---------- Claude (IA) ----------
# Sin ANTHROPIC_API_KEY la IA se desactiva y el resto del bot funciona igual.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Responder en chat privado a cualquier mensaje (sin prefijo)
AI_PRIVATE_CHAT=true
# Responder en grupos cuando mencionan al bot o citan uno de sus mensajes
AI_REPLY_TO_MENTIONS=true
# Límites de uso
AI_USER_HOURLY_LIMIT=20
AI_DAILY_TOKEN_BUDGET=2000000
AI_MEMORY_TURNS=20
AI_MEMORY_TTL_MINUTES=120
AI_MAX_OUTPUT_TOKENS=1024
# Esfuerzo de razonamiento (low | medium | high). low es suficiente para chat.
AI_EFFORT=low
# Texto extra para la personalidad del bot (opcional)
AI_PERSONA=

# ---------- Opcionales ----------
# Servicio propio de descargas (carpeta downloader/). Vacío = comandos de descarga deshabilitados.
DOWNLOADER_API_URL=
# Tiempo máximo por descarga en ms; el bot nunca espera menos de 120000
DOWNLOADER_API_TIMEOUT_MS=120000
# Debe coincidir con DOWNLOADER_API_KEY del servicio si este la define (cabecera x-api-key)
DOWNLOADER_API_KEY=
# Carpeta de archivos temporales de ffmpeg (stickers, conversiones). Por defecto ./tmp
TMP_DIR=
# Token para que /bug y /feat creen issues en GitHub
GITHUB_TOKEN=
GITHUB_REPO=cyal-dev3/cyalbot

# ---------- Puente Telegram -> WhatsApp (opcional) ----------
# Credenciales de https://my.telegram.org/apps. Genera la sesión con `npm run telegram:session`.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=
# IDs de grupos de Telegram a escuchar (separados por coma) y grupo de WhatsApp destino
TELEGRAM_GROUP_IDS=
WHATSAPP_GROUP_ID=
